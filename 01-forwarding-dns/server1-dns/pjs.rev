$TTL 4
@       IN SOA  ns1.pjs.com. root.pjs.com. (
                                        10      ; serial
                                        1D      ; refresh
                                        1H      ; retry
                                        1W      ; expire
                                        3H )    ; minimum

;; (0) DNS Server
                IN  NS          ns1.pjs.com.
11              IN  PTR         ns1.pjs.com.
