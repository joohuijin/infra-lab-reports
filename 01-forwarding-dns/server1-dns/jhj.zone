$TTL 4
@       IN SOA  ns1.jhj.com. root.jhj.com. (
                                        10      ; serial
                                        1D      ; refresh
                                        1H      ; retry
                                        1W      ; expire
                                        3H )    ; minimum
;; (0) DNS Server
jhj.com.                 IN   NS   ns1.jhj.com.
ns1.jhj.com.             IN   A    192.168.50.11
;; (1) WEB Server
@                        IN   A    192.168.50.10
www                      IN   A    192.168.50.10

;; (2) FTP Server
ftp                      IN   A    192.168.50.10
